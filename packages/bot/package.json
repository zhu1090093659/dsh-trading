{
  "name": "@dshtrading/bot",
  "description": "Bot-plane bundle for dsh-trading: the Agent-host surface that runs on a headless Linux server (no webserver / connection / modules rows). Skeleton created in P1; P2 adds the bot-startup provider row and the transport row here.",
  "version": "0.5.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./http": {
      "types": "./lib/http.d.ts",
      "default": "./lib/http.js"
    },
    "./package.json": "./package.json",
    "./startup": {
      "types": "./lib/startup.d.ts",
      "default": "./lib/startup.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "dependencies": {
    "@dshtrading/base": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-cmdline": "0.2.0-rc.2",
    "commander": "^13.0.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-cmdline": ">=0.2.0-rc.2",
    "commander": ">=12.0.0"
  }
}
