{
  "name": "@dshtrading/bot",
  "description": "Bot-plane bundle for dsh-trading: the Agent-host surface that runs on a headless Linux server (no webserver / connection / modules rows). Skeleton created in P1; P2 adds the bot-startup provider row and the transport row here.",
  "version": "0.5.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@dshtrading/base": "workspace:^"
  },
  "devDependencies": {
    "tsdown": "^0.22.0",
    "typescript": "^5.9.3"
  }
}
