{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib"
  },
  // 与搬包前的 @dshtrading/client-ui-trading/tsconfig.json 保持**同一口径**：
  // 当时它也只含 src/index.ts + src/bridge.ts。2026-10-01 搬包时实测：把 include
  // 放宽到 "src" 会 surface 6 处既有错误（index.ts 4 + tasks/tools.ts 2，均为
  // ctx.inject / ctx.effect 找不到），根因是更宽的类型程序里 cordis 的 Context
  // 增强（declare module '@deepseek-ai/cordis'）没有生效——这是既有债 + 一个独立的
  // 类型环境问题，不该由「包边界搬家」这个变更顺手吞掉或顺手掩盖。
  // 后续项：单独一个变更诊断增强丢失并把这 6 处清掉，再把 include 放宽到 "src"。
  "include": [
    "src/index.ts",
    "src/bridge.ts"
  ]
}
