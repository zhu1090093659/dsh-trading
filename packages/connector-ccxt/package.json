{
  "name": "@dshtrading/connector-ccxt",
  "description": "沿用 CCXT 所名词汇的加密现货多所行情连接器（自写 binance/okx/bybit 三条直连分支，不依赖 ccxt 库）：ticker 与 K 线 + 保留三态闸门的交易占位服务；现货限定，账户读面未实现。",
  "version": "0.6.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./dataplane": {
      "types": "./lib/dataplane.d.ts",
      "default": "./lib/dataplane.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "dependencies": {
    "@dshtrading/authority": "workspace:^",
    "@dshtrading/api": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "devDependencies": {
    "tsdown": "^0.22.0",
    "vitest": "^3.0.0"
  }
}
