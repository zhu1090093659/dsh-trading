  "dependencies": {
    "@dshtrading/api": "workspace:^",
    "@dshtrading/indicators": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "devDependencies": {
    "@dshtrading/connector-binance": "workspace:^",
    "tsdown": "^0.22.0",
    "vitest": "^3.0.0"
  }
