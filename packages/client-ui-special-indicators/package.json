{
  "name": "@dshtrading/client-ui-special-indicators",
  "description": "Special indicators stage view plugin for dsh-trading (LOCAL ONLY, never published): registers the 中栏「特殊指标」tab via the tradingStageViews service — proprietary indicators served by the owner's self-hosted finance service (IF/IM 期现基差, A股恐慌指数, 恒科权重股卖空, 板块融资余额). Node half proxies the finance HTTP API behind the browser-auth fence at /dshtrading/api/special-indicators with a TTL cache; credentials stay in the local profile row config / env (BYOK), never in the repo.",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locales": {
      "types": "./lib/client/locales.d.ts",
      "default": "./lib/client/locales.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "UNLICENSED",
  "scripts": {
    "bundle": "tsdown && tsdown --config tsdown.client.config.mjs",
    "build": "tsdown && tsdown --config tsdown.client.config.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@dshtrading/dsh-home": "workspace:^",
    "lightweight-charts": "^5.2.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "lightningcss": "^1.0.0",
    "react": "^18.2.0",
    "jsdom": "^30.0.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
