{
  "name": "@dshtrading/connector-alpaca",
  "description": "美股（us）行情与交易连接器：直连 Alpaca Market Data v2（IEX feed）与 Trading API v2（Paper/Live），实现 MarketDataService/TradeService 双契约，服务键 tradingUsMarketData/tradingUsTrade，三态闸门 + dry-run 缺省 + BYOK 凭证 ref。",
  "version": "0.6.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./dataplane": {
      "types": "./lib/dataplane.d.ts",
      "default": "./lib/dataplane.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "dependencies": {
    "@dshtrading/authority": "workspace:^",
    "@dshtrading/api": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "devDependencies": {
    "tsdown": "^0.22.0",
    "vitest": "^3.0.0"
  }
}
