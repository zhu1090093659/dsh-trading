{
  "name": "@dshtrading/indicators",
  "description": "Technical indicator core library for dsh-trading: pure math kernel, indicator definition types, registry factory and preset definitions. Pure library (not a dsh bundle) — consumed by client-ui-trading (UI + local registry) and client-ui-indicators (preset provider plugin).",
  "version": "0.1.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tool": {
      "types": "./lib/tool.d.ts",
      "default": "./lib/tool.js"
    },
    "./plugin": {
      "types": "./lib/plugin.d.ts",
      "default": "./lib/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1"
  },
  "devDependencies": {
    "tsdown": "^0.22.0",
    "vitest": "^3.0.0",
    "typescript": "^5.5.0"
  }
}
