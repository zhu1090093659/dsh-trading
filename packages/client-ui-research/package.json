{
  "name": "@dshtrading/client-ui-research",
  "description": "Native Research workspace for dsh-trading, with migrated research, data, calculation and report engines running in the DSH host.",
  "version": "0.6.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locales": {
      "types": "./lib/client/locales.d.ts",
      "default": "./lib/client/locales.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "runtime",
    "setup-python.mjs"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "bundle": "node build-runtime.mjs && tsdown && tsdown --config tsdown.client.config.mjs && vite build --config workbench/vite.config.mts",
    "build": "node build-runtime.mjs && tsdown && tsdown --config tsdown.client.config.mjs && vite build --config workbench/vite.config.mts",
    "test": "node build-runtime.mjs && vitest run --passWithNoTests",
    "setup:python": "node setup-python.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "react": "^18.2.0",
    "@types/react": "~18.3.1",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.2"
  },
  "devDependencies": {
    "lightningcss": "^1.0.0",
    "react": "^18.2.0",
    "@types/react": "~18.3.1",
    "tsdown": "^0.22.0",
    "vitest": "^3.0.0",
    "typescript": "^5.5.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.4.2",
    "tailwindcss": "^3.4.17",
    "@tailwindcss/typography": "^0.5.20",
    "postcss": "^8.5.6",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "echarts": "^6.0.0",
    "lucide-react": "^0.460.0",
    "react-dom": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^7.1.0",
    "remark-gfm": "^4.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.1",
    "zustand": "^5.0.0",
    "@types/mdast": "^4.0.4"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@dshtrading/dsh-home": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.17.1",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "^6.2.108",
    "zod": "^4.4.3"
  }
}
