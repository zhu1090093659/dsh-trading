{
  "name": "@dshtrading/connector-hithink",
  "description": "同花顺（问财）OpenAPI A 股与期货数据连接器（BYOK，凭证 ref 为 HITHINK_FINANCE_API_KEY）：实现 tradingCnMarketData 与 tradingFuturesMarketData 行情服务（ticker / K 线 / 基本面 / 集合竞价 / 连板池）；仅数据面，无交易通道、不注册工具。",
  "version": "0.6.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./dataplane": {
      "types": "./lib/dataplane.d.ts",
      "default": "./lib/dataplane.js"
    },
    "./futures": {
      "types": "./lib/futures.d.ts",
      "default": "./lib/futures.js"
    },
    "./futures-dataplane": {
      "types": "./lib/futures-dataplane.d.ts",
      "default": "./lib/futures-dataplane.js"
    },
    "./futures-plugin": {
      "types": "./lib/futures-plugin.d.ts",
      "default": "./lib/futures-plugin.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "dependencies": {
    "@dshtrading/api": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "devDependencies": {
    "tsdown": "^0.22.0",
    "vitest": "^3.0.0"
  }
}
