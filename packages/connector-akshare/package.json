{
  "name": "@dshtrading/connector-akshare",
  "description": "AkShare 名义的 A 股宏观/另类数据连接器：实现面为东方财富公开 REST 直连（push2/push2his）、交易所份额披露与腾讯指数日线，提供 tradingCnMarketData 行情服务（含「ETF 托底」getEtfRescue 能力）与 cn_get_ticker / cn_get_klines / cn_get_sector_fund_flow 三个工具，无交易通道。",
  "version": "0.8.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./dataplane": {
      "types": "./lib/dataplane.d.ts",
      "default": "./lib/dataplane.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "dependencies": {
    "@dshtrading/api": "workspace:^",
    "@dshtrading/dsh-home": "workspace:^",
    "fflate": "^0.8.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.5",
    "@deepseek-ai/schemastery": ">=3.19.0"
  },
  "devDependencies": {
    "tsdown": "^0.22.0",
    "vitest": "^3.0.0"
  }
}
