{
  "name": "@dshtrading/client-ui-settings",
  "description": "Trading settings section for the dsh web client: market → provider routing (dshtrading namespace). Browser half is a dsh.client bundle; node half is the host row placeholder.",
  "version": "0.6.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locales": {
      "types": "./lib/client/locales.d.ts",
      "default": "./lib/client/locales.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "bundle": "tsdown && tsdown --config tsdown.client.config.mjs",
    "build": "tsdown && tsdown --config tsdown.client.config.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@dshtrading/router": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-store": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.2-rc.1",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@dshtrading/connector-akshare": "workspace:^",
    "@dshtrading/connector-alpaca": "workspace:^",
    "@dshtrading/connector-finnhub": "workspace:^",
    "@dshtrading/connector-fmp": "workspace:^",
    "@dshtrading/connector-futu": "workspace:^",
    "@dshtrading/connector-hithink": "workspace:^",
    "@dshtrading/connector-ibkr": "workspace:^",
    "@dshtrading/connector-jin10": "workspace:^",
    "@dshtrading/connector-longbridge": "workspace:^",
    "@dshtrading/connector-okx": "workspace:^",
    "@dshtrading/connector-polygon": "workspace:^",
    "@dshtrading/connector-qmt": "workspace:^",
    "@dshtrading/connector-tiger": "workspace:^",
    "@dshtrading/connector-tushare": "workspace:^",
    "@dshtrading/connector-xysz": "workspace:^",
    "@types/react": "~18.3.1",
    "jsdom": "^30.1.1",
    "lightningcss": "^1.0.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.0",
    "vitest": "^3.0.0"
  }
}
