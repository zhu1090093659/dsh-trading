{
  "name": "@dshtrading/client-ui-trading",
  "description": "Professional three-column trading terminal shell for the dsh web client: market/watchlist sidebar (shell.overlay), Lightweight Charts v5 quote stage view (MiddleStage), hero-fused session history (shadows sidebar.workspaces), session rail (fold/new/settings), and the /dshtrading/api market-data HTTP bridge on the node half.",
  "version": "0.1.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locales": {
      "types": "./lib/client/locales.d.ts",
      "default": "./lib/client/locales.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "bundle": "tsdown && tsdown --config tsdown.client.config.mjs",
    "build": "tsdown && tsdown --config tsdown.client.config.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@dshtrading/api": "workspace:^",
    "@dshtrading/eventbus": "workspace:^",
    "@dshtrading/indicators": "workspace:^",
    "@dshtrading/knowledge": "workspace:^",
    "@dshtrading/strategies": "workspace:^",
    "@dshtrading/router": "workspace:^",
    "@dshtrading/watchlist": "workspace:^",
    "@dshtrading/kit-cn": "workspace:^",
    "@dshtrading/kit-hk": "workspace:^",
    "@dshtrading/kit-us": "workspace:^",
    "@dshtrading/kit-crypto": "workspace:^",
    "lightweight-charts": "^5.2.1",
    "@dshtrading/client-ui-strategies": "workspace:^",
    "@dshtrading/client-ui-knowledge": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "lightningcss": "^1.0.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.0",
    "vitest": "^3.0.0",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.2-alpha.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.0.1",
    "react-dom": "^18.3.1"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  }
}
