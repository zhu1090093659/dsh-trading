{
  "name": "@dsh-trading/client-ui-strategies",
  "description": "Strategy stage view plugin for dsh-trading (issue #34 / P5): registers the 中栏「策略」tab via the tradingStageViews service — horizon segmented control, strategy cards, backtest runner with equity curve and trade log. Engine comes from the @dsh-trading/strategies pure library; bridge access goes through the shell's tradingBridge service (ctx.inject only, no cross-package module imports).",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "scripts": {
    "bundle": "tsdown && tsdown --config tsdown.client.config.mjs",
    "build": "tsdown && tsdown --config tsdown.client.config.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@dsh-trading/strategies": "workspace:^",
    "lightweight-charts": "^5.2.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-alpha.1",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
