{
  "name": "@dshtrading/connector-qmt",
  "description": "迅投 MiniQMT A 股券商实盘交易与行情连接器：提供 tradingCnMarketData 与 tradingCnTrade 两个服务，注册 cn_get_ticker / cn_get_klines / cn_place_order / cn_cancel_order / cn_get_balance 五个工具，实盘受 @dshtrading/authority 签署平面与服务缝三态闸门约束。",
  "version": "0.6.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./dataplane": {
      "types": "./lib/dataplane.d.ts",
      "default": "./lib/dataplane.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "dependencies": {
    "@dshtrading/authority": "workspace:^",
    "@dshtrading/api": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "devDependencies": {
    "tsdown": "^0.22.0",
    "vitest": "^3.0.0"
  }
}
