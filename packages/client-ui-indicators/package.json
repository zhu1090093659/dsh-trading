{
  "name": "@dsh-trading/client-ui-indicators",
  "description": "Technical indicator provider plugin for dsh-trading: provides the tradingIndicators service (IndicatorRegistry with six presets MA/EMA/BOLL/MACD/RSI/KDJ) on the client context. Community indicators consume the same service via ctx.inject. Node half is a host loader placeholder; the browser half owns the service.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.client.config.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@dsh-trading/indicators": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "devDependencies": {
    "tsdown": "^0.22.0",
    "vitest": "^3.0.0",
    "typescript": "^5.5.0"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}
