{
  "name": "@dshtrading/root",
  "version": "0.1.0",
  "description": "Your next trading terminal can also be DSH. Full-market (Crypto/US/CN/HK) modular AI trading terminal and plugin ecosystem on DeepSeek Harness.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "sync:skills": "node scripts/sync-skills.mjs",
    "build": "pnpm sync:skills && pnpm -r build",
    "test": "vitest run --passWithNoTests",
    "i18n:check": "node scripts/i18n-audit.mjs --check",
    "i18n:report": "node scripts/i18n-audit.mjs --report",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cosmokit": "^1.8.3",
    "@deepseek-ai/dsh-skill": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^24.0.0",
    "lightningcss": "^1.33.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
