{
  "name": "@dshtrading/root",
  "version": "0.1.0",
  "description": "Your next trading terminal can also be DSH. Full-market (Crypto/US/CN/HK) modular AI trading terminal and plugin ecosystem on DeepSeek Harness.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "authority:sign": "node packages/authority/bin/sign-live-trading.mjs",
    "bot-closure:check": "node scripts/bot-closure-acceptance.mjs",
    "build": "pnpm sync:skills && pnpm -r build",
    "changeset": "changeset",
    "ci-wiring:check": "node scripts/ci-wiring-check.mjs",
    "contract-id:check": "node scripts/contract-id-gate.mjs",
    "coverage:check": "node scripts/coverage-gate.mjs --check",
    "coverage:update": "node scripts/coverage-gate.mjs --update",
    "e2e:smoke": "node scripts/e2e-smoke.mjs",
    "gates:all": "node scripts/gates-all.mjs",
    "home-guard:check": "node scripts/home-guard-check.mjs",
    "i18n:check": "node scripts/i18n-audit.mjs --check",
    "i18n:report": "node scripts/i18n-audit.mjs --report",
    "live-trading:check": "node scripts/live-trading-gate.mjs",
    "live-trading:report": "node scripts/live-trading-gate.mjs --report",
    "patch-id:check": "node scripts/patch-id-gate.mjs",
    "patch-id:report": "node scripts/patch-id-gate.mjs --report",
    "patch-id:update": "node scripts/patch-id-gate.mjs --update",
    "plane:check": "node scripts/plane-closure-gate.mjs",
    "release": "pnpm build && changeset publish",
    "sync:skills": "node scripts/sync-skills.mjs",
    "test": "vitest run --passWithNoTests",
    "test:audit": "node scripts/test-audit.mjs --check",
    "test:audit:report": "node scripts/test-audit.mjs --report",
    "test:desktop": "node --test \"desktop/tests/*.test.mjs\"",
    "test:scripts": "vitest run scripts --passWithNoTests",
    "ui:check": "node scripts/ui-functional-check.mjs",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/cosmokit": "^1.8.5",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "fflate": "^0.8.2",
    "lightningcss": "^1.33.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0",
    "yaml": "^2.9.0"
  }
}
