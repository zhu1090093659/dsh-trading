node_modules/
lib/
dist/
.coverage/
*.log
.DS_Store
.zcode/
.local/

# 任务工作树（dsh-customize 约定的仓库内位置）：每次任务独立 worktree，
# 不入库，也不应污染主检出的状态。
.worktrees/

# 集成锁（dsh-customize 集成纪律）：锁定 staging 期间的互斥文件。
# 锁用 `flock`（2026-10-20 经 Homebrew 安装，/opt/homebrew/bin/flock），
# 锁文件本身绝不入库。
.agents/merge.lock

# 私有卫星仓（自动交易平面）产物的投放槽位：只放 .tgz，且绝不入库。
# 产物里含自动交易源码，是"可部署能力"的载体，不是主仓内容。
desktop/satellite-vendor/
