# 执行核：三进程里唯一持有凭据与账本的进程（§13 #18-3 凭据只住核心侧）。
# 安装前请读 deploy/README.md；本文件**不**由 agent 自动安装。
#
# ExecStart 指向真实产物：/opt/dsh-trading/tradectl 是 @dshtrading/tradectl 包树的部署副本
# （含 bin/ 与构建产物 lib/）。入口自己会选实现：lib/ 新鲜就用 lib/，src/ 更新就改用源码。
[Unit]
Description=dsh-trading execution core (ledgers, safe boot, UDS, A0 kill state)
Documentation=file:///opt/dsh-trading/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
# 入口不实现 sd_notify，所以不是 notify 型；用 exec 才能让"起没起来"由真实 exec 决定。
Type=exec
User=dsh-trade-core
Group=dsh-trade
# 独立 uid（§13 #18-4）：核心 = dsh-trade-core，edge = dsh-trade-edge，宿主 = dsh-trade-bot。
SupplementaryGroups=dsh-trade
Environment=DSH_HOME=/var/lib/dsh-trading
Environment=NODE_ENV=production
# 账本与凭据目录归核心，0700/0600（其它两个 uid 连读都不行）。
UMask=0077
# /run/dsh-tradectl 0750：UDS socket 所在目录（§13 #17，组可进入不可写）。
RuntimeDirectory=dsh-tradectl
RuntimeDirectoryMode=0750
# /var/lib/dsh-trading 0700：账本（orders/audit/market）+ 心跳 + 写探针。
StateDirectory=dsh-trading
StateDirectoryMode=0700
# --form production 要求显式声明 --separate-uids（§13 #18-4：独立 uid 不可用必须声明为开发形态）。
# --kill-state：带外 kill/pause 状态文件（edge 写、核心读）；被杀/暂停时入口拒绝启动。
ExecStart=/usr/bin/env node /opt/dsh-trading/tradectl/bin/core.mjs --home /var/lib/dsh-trading --form production --separate-uids --kill-state /var/lib/dsh-trading-a0/kill.json --uds-socket /run/dsh-tradectl/core.sock
Restart=on-failure
RestartSec=2
# 保护：不允许核心以外的东西写它的账本
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dsh-trading /run/dsh-tradectl

[Install]
WantedBy=multi-user.target
