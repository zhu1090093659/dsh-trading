{
  "note": "US face on real OpenD (SIMULATE); account ids redacted. HK 面见 trd-*.json。",
  "steps": [
    {
      "case": "美股下单（US.AAPL 限价买 1 @ 330）",
      "path": "/api/trd/place-order",
      "request": {
        "security": "US.AAPL",
        "trdSide": 1,
        "orderType": 1,
        "qty": 1,
        "price": 330.0,
        "trdEnv": "SIMULATE",
        "accId": "<redacted-usAccId>",
        "remark": "us-bridge-anchor-1"
      },
      "httpStatus": 200,
      "raw": {
        "retType": 0,
        "retMsg": "",
        "data": {
          "orderId": "9769923",
          "code": "US.AAPL"
        }
      }
    },
    {
      "case": "美股挂单列表（读回这一单与锚）",
      "path": "/api/trd/get-orders",
